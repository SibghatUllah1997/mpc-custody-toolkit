{
  "name": "mpc-custody-toolkit",
  "version": "0.1.0",
  "description": "An educational MPC / custody wallet toolkit: secp256k1 keygen + Shamir sharing.",
  "author": "HM Sibghat Ullah <h.m.sibghatullah1997@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src"
  ],
  "bin": {
    "mpc-toolkit": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "node dist/src/cli.js bench",
    "docs:build": "mdbook build website",
    "docs:api": "UPDATE_API_DOCS=1 vitest run test/docs.api.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SibghatUllah1997/mpc-custody-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/SibghatUllah1997/mpc-custody-toolkit/issues"
  },
  "homepage": "https://github.com/SibghatUllah1997/mpc-custody-toolkit#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.1.9",
    "fast-check": "^4.10.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
